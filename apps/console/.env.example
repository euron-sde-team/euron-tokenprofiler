# Base URL of the TokenProfiler API, as seen from the browser.
NEXT_PUBLIC_TP_API_URL=http://localhost:8380
# LOCAL DEMOS ONLY: pre-fills the connect form. Never set this for a shared deployment,
# because NEXT_PUBLIC_* values are shipped to every visitor's browser.
# NEXT_PUBLIC_TP_DEFAULT_API_KEY=tp_demo0000_local-only-key
