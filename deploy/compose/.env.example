# `make env` generates deploy/compose/.env with random local-only secrets. These are the knobs you can add to it.
# TP_API_KEY_PEPPER=...            (generated)
# TP_BOOTSTRAP_API_KEY=tp_...      (generated)
# TP_API_PORT=8380
# TP_CONSOLE_PORT=3300
# TP_MOCK_PORT=8390
# TP_FLOCI_PORT=4866
# TP_UPSTREAM_BASE_URL=https://api.openai.com/v1   point the proxy at a real provider instead of the mock
# TP_UPSTREAM_API_KEY=sk-...
