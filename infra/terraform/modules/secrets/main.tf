# Deployment secrets generated by Terraform and read by the API at startup.

resource "random_password" "pepper" {
  length  = 48
  special = false
}

resource "random_id" "bootstrap_prefix" {
  byte_length = 4
}

resource "random_password" "bootstrap_secret" {
  length  = 32
  special = false
}

locals {
  bootstrap_api_key = coalesce(var.bootstrap_api_key, "tp_${random_id.bootstrap_prefix.hex}_${random_password.bootstrap_secret.result}")
}

resource "aws_secretsmanager_secret" "app" {
  name                    = "${var.name}/app"
  description             = "TokenProfiler API key pepper and bootstrap key"
  recovery_window_in_days = var.recovery_window_in_days
  kms_key_id              = var.kms_key_id
  tags                    = var.tags
}

resource "aws_secretsmanager_secret_version" "app" {
  secret_id = aws_secretsmanager_secret.app.id
  secret_string = jsonencode({
    api_key_pepper    = random_password.pepper.result
    bootstrap_api_key = local.bootstrap_api_key
  })
}
